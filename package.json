{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt --write app features tests docs README.md package.json vite.config.ts next.config.ts tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format:check": "oxfmt --check app features tests docs README.md package.json vite.config.ts next.config.ts tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.3",
    "@cloudflare/workers-types": "5.20260930.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.145.0"
  },
  "type": "module",
  "overrides": {
    "image-size": "2.0.3"
  }
}
